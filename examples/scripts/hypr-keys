#!/bin/bash
# @omalaunch.title Search Key Bindings
# @omalaunch.mode filter
# @omalaunch.keyword keys
# @omalaunch.icon ⌨
# @omalaunch.description Find a Hyprland binding by what it does; Enter copies the keys
#
# A script filter: called with the search text as $1, it prints JSON items.
# Enter calls it again as `hypr-keys --run <arg>`.

if [[ $1 == --run ]]; then
  printf '%s' "$2" | wl-copy && echo "Copied $2"
  exit
fi

mods() { # modmask -> "SUPER + SHIFT + "
  local m=$1 s=""
  (( m & 64 )) && s+="SUPER + "; (( m & 4 )) && s+="CTRL + "
  (( m & 8 )) && s+="ALT + "; (( m & 1 )) && s+="SHIFT + "
  printf '%s' "$s"
}

hyprctl binds -j | jq -c --arg q "${1,,}" '
  [ .[] | select(.description != "")
        | select(($q == "") or ((.description + " " + .key) | ascii_downcase | contains($q))) ]
  | .[:40][] | [.modmask, .key, .description, .dispatcher, .arg]' |
while IFS= read -r line; do
  mask=$(jq -r '.[0]' <<<"$line")
  jq -c --arg mods "$(mods "$mask")" '{
    title: .[2],
    subtitle: ($mods + .[1]),
    arg: ($mods + .[1])
  }' <<<"$line"
done | jq -s '{items: .}'
